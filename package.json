{
  "name": "visualmind-ai",
  "version": "1.0.0",
  "description": "Automated Visual Knowledge Extraction Engine for Complex Study Materials",
  "author": "VisualMind AI",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "tsx supabase/migrate.ts",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n \"SERVER,CLIENT,APP\" -c \"cyan,magenta,yellow\" \"npm run server\" \"npm run client\" \"wait-on http://localhost:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "mermaid": "^12.0.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "ai.visualmind.app",
    "productName": "VisualMind AI",
    "directories": {
      "output": "C:/Users/Rushikesh/.visualmind-release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VisualMind AI"
    }
  }
}
